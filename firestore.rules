rules_version = '2';

// ============================================================================
// Recipe Planner – Firestore Security Rules
// ============================================================================
//
// Access model (binary: authorised / refused)
// ─────────────────────────────────────────────
//  • Only users whose UID exists as a document in `users/{uid}` are granted
//    read access to any collection.
//  • NO writes are allowed from client applications (admin / backend only).
//  • A user may only read their OWN document in `users`.
//  • Even if the Flutter app is modified or reversed, an absence of the
//    `users/{uid}` document prevents ALL data access server-side.
//
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper function
    // -------------------------------------------------------------------------

    /// Returns true if the caller is authenticated AND their UID exists as a
    /// document in the `users` collection (created at first login).
    function isAuthorised() {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------------
    // users collection
    // -------------------------------------------------------------------------
    // • get/list : tout utilisateur authentifié — nécessaire pour la lookup
    //   par email avant que users/{uid} existe (premier login).
    // • create   : son propre doc (auth service au 1er login)
    //              OU admin (crée des docs d'invitation avec ID aléatoire).
    // • update   : son propre doc uniquement.
    // • delete   : admin (suppression d'un utilisateur)
    //              OU tout utilisateur authentifié supprimant un doc sans nom
    //              (doc d'invitation consommé lors de la migration).
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow get:    if request.auth != null;
      allow list:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid || isAdmin();
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin()
                    || (request.auth != null && resource.data.get('name', '') == '');

      match /recipeServings/{docId} {
        allow read, write, delete: if isAuthorised();
      }
    }

    // -------------------------------------------------------------------------
    // recipes collection
    // -------------------------------------------------------------------------
    match /recipes/{recipeId} {
      allow read, write: if isAuthorised();

      match /{subCollection}/{docId} {
        allow read, write: if isAuthorised();
      }
    }

    // -------------------------------------------------------------------------
    // All other collections (ingredients, categories, mealPlans, etc.)
    // -------------------------------------------------------------------------
    match /{collection}/{docId} {
      allow read, write: if isAuthorised();

      match /{subCollection}/{subDocId} {
        allow read, write: if isAuthorised();
      }
    }
  }
}
